model Account {
  id        String   @id @default(uuid()) // Using uuid() for unique indentification
  email     String   @unique @map("email") // Create unique email for user authentication
  password  String   @map("password")   
  name      String   @map("name")   // Users full name
  createdAt DateTime @default(now()) @map("created_at") // Date for account creation

}
