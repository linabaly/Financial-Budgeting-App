# Server Configuration
$env:PORT = "3000"
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secure_secret_key_change_this_in_production
JWT_EXPIRATION=3600 # 1 hour in seconds

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_budgeting
DB_USER=postgres
DB_PASSWORD=password

# Security
REQUIRE_HTTPS=true
SESSION_SECRET=another_secure_session_secret_change_this_in_production